# Absolute path containing maps/ and nuplan-v1.1/.
NUPLAN_HOST_DATA_ROOT=/absolute/path/to/nuplan-dataset

# Host directory for simulation logs and metrics. Relative to the repository root.
# Docker mounts this directory at /artifacts; matched runs use mini_68/ (smoke: mini_1/).
NUPLAN_HOST_ARTIFACT_ROOT=./artifacts

# Team Google Drive folder holding the nuPlan archives (tools/download_nuplan_drive.ps1).
# Ask the data owners for the ID; never commit it (public repository).
NUPLAN_DRIVE_FOLDER_ID=
