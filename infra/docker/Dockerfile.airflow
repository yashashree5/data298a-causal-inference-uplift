# Airflow 2.x for the nuplan_pipeline DAG (dags/). See dags/README.md.
FROM apache/airflow:2.10.5-python3.11

# Planner tasks start the planner container through the host's Docker daemon.
COPY --from=docker:29-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli /usr/local/libexec/docker/cli-plugins/docker-compose \
    /usr/local/libexec/docker/cli-plugins/docker-compose

# The data tools get their own virtualenv so their versions do not fight Airflow's
# pinned dependencies. These match the versions the test suite runs against.
ENV TOOLS_PYTHON=/opt/tools-venv/bin/python
USER root
RUN python -m venv /opt/tools-venv \
    && /opt/tools-venv/bin/pip install --no-cache-dir \
        pandas==3.1.1 numpy==2.4.6 pyarrow==26.0.1 pyyaml==6.0.3 duckdb==2.0.0 \
        pyproj==3.7.2 shapely==2.2.0 requests==2.34.2
USER airflow
